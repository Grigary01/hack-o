# Скопируйте в .env.local и при необходимости поменяйте.
# mock — полностью автономное демо без бэкенда; api — реальные эндпоинты FastAPI.
# Автоматического переключения с API на моки при ошибке нет.
VITE_DATA_MODE=mock
# Куда Vite проксирует /api в режиме api (uvicorn app.main:app --port 8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
