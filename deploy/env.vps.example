# .env для сервера с доменом (копия → /opt/ostrovok/.env, права 600).
# После правки: cd /opt/ostrovok && docker compose up -d

# Запуск с Caddy и HTTPS (deploy/docker-compose.vps.yml).
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.vps.yml
DOMAIN=o.devneli.ru

# Модель: облачная через OpenAI-совместимый прокси.
LLM_PROVIDER=cloud
# Адрес OpenAI-совместимого API прокси, например https://<адрес прокси>/v1.
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=claude-opus-5
# ← впишите ключ прокси. Пока пусто — запросы разбирают правила, сайт работает.
LLM_API_KEY=
