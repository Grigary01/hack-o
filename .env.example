# Настройки запуска через Docker Compose. Все переменные необязательны:
# без .env приложение запускается со значениями по умолчанию (они указаны ниже).
#   cp .env.example .env
# Не коммитьте .env с настоящими ключами.

# Порт интерфейса на хосте: http://localhost:8080
WEB_PORT=8080

# Ответы отельеров из демо-набора участвуют в подборе и помечаются как тестовые.
DEMO_MODE=true

# --- Разбор запроса гостя ---
# Пусто — режим из config/models.yaml (hybrid: правила + LLM на непонятом).
# Без LLM гибрид работает на правилах — ключи и модели для запуска не нужны.
# offline — только правила; groq — облачная модель через OpenAI-совместимое API.
PARSER_MODE=
REPLY_PARSER_MODE=

# Облачная LLM через любое OpenAI-совместимое API (необязательно).
# Пример: PARSER_MODE=groq, CLOUD_LLM_BASE_URL=https://<провайдер>/v1, CLOUD_LLM_MODEL=<модель>, ключ в GROQ_API_KEY.
# Пусто — Groq (https://api.groq.com/openai/v1) и модель из config/models.yaml.
GROQ_API_KEY=
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
# Какая LLM дополняет правила в режиме hybrid: ollama | groq. Пусто — из config/models.yaml.
HYBRID_LLM=

# Локальная модель через Ollama на хосте (необязательно): ollama pull gemma3:12b
DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# --- Только для запуска без Docker и служебных скриптов (см. docs/DEVELOPMENT.md) ---
# DATABASE_URL=sqlite:///runtime/adler.db
# OLLAMA_URL=http://127.0.0.1:11434
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OPENAQ_API_KEY=
# NOISEMODELLING_HOME=
# NOISE_JAVA_HOME=
