# Общие настройки модели — в config/models.yaml (Git).
# Здесь только локальное окружение и секреты. Не коммитьте свой .env.
# Для UI-разработки без модели можно явно включить PARSER_MODE=offline.
# Обработка ответа отельера: rules (offline), fixture (заглушка ML), ollama, groq.
REPLY_PARSER_MODE=rules
OLLAMA_URL=http://127.0.0.1:11434
DATABASE_URL=sqlite:///runtime/adler.db
API_URL=http://127.0.0.1:8000
DEMO_MODE=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Получить ключ: https://explore.openaq.org/register (никогда не коммитить .env)
OPENAQ_API_KEY=
# NoiseModelling without_gui 5.0.1, только для отдельной CLI-команды
NOISEMODELLING_HOME=
NOISE_JAVA_HOME=
# Облачный ключ: https://console.groq.com/keys; режим/model — в config/models.yaml
GROQ_API_KEY=

# Docker Compose (compose.yaml): DATABASE_URL и адреса между контейнерами заданы там.
# Порты на хосте (слушают только 127.0.0.1):
WEB_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=8501
# Разбор запроса в контейнере: offline — свободный текст без LLM; ollama/groq — модель.
DOCKER_PARSER_MODE=offline
# Ollama работает на хосте; localhost внутри контейнера — сам контейнер.
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
