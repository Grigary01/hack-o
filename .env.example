# Общие настройки модели — в config/models.yaml (Git).
# Здесь только локальное окружение и секреты. Не коммитьте свой .env.
# Для UI-разработки без модели можно явно включить PARSER_MODE=offline.
OLLAMA_URL=http://127.0.0.1:11434
# Docker обращается к Ollama на хосте; для отдельного сервера поменяйте адрес:
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434
DATABASE_URL=sqlite:///runtime/adler.db
API_URL=http://127.0.0.1:8000
DEMO_MODE=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Получить ключ: https://explore.openaq.org/register (никогда не коммитить .env)
OPENAQ_API_KEY=
# NoiseModelling without_gui 5.0.1, только для отдельной CLI-команды
NOISEMODELLING_HOME=
NOISE_JAVA_HOME=
# Облачный ключ: https://console.groq.com/keys; режим/model — в config/models.yaml
GROQ_API_KEY=
