# Настройки запуска через Docker Compose. Все переменные необязательны:
# без .env приложение запускается и работает (запросы разбираются правилами, без модели).
#   cp .env.example .env
# Значения по умолчанию указаны в комментариях. Не коммитьте .env — он в .gitignore.
# Ключей в репозитории нет: для модели заполните свой ключ ниже (см. README, «Ключи»).

# Порт интерфейса на хосте. По умолчанию 8080 → http://localhost:8080
WEB_PORT=

# Учитывать тестовые ответы отелей из демо-набора (помечены в интерфейсе). По умолчанию true.
DEMO_MODE=

# ===== Модель для разбора запроса гостя =====
# LLM_PROVIDER: cloud | local | off. Пусто — режим из config/models.yaml (правила + локальная модель,
# если она доступна, иначе только правила).
#   cloud — облачная модель через OpenAI-совместимое API (заполните блок «Облако» ниже);
#   local — gemma3:12b через Ollama (заполните блок «Локально» ниже);
#   off   — только правила, модель не нужна.
LLM_PROVIDER=

# --- Облако (LLM_PROVIDER=cloud) ---
# Адрес прокси к модели (OpenAI-совместимый API), например https://<адрес прокси>/v1.
CLOUD_LLM_BASE_URL=
# Имя модели у провайдера, например claude-opus-5.
CLOUD_LLM_MODEL=
# Ключ провайдера LLM — свой (в репозиторий не коммитить).
LLM_API_KEY=

# --- Локально (LLM_PROVIDER=local) ---
# local-llm — поднять Ollama в Docker и автоматически скачать модель (~8 ГБ, нужно ~12 ГБ RAM).
# Пусто — Ollama в Docker не запускается.
COMPOSE_PROFILES=
# Своя Ollama вместо контейнера, например http://host.docker.internal:11434 (на Mac быстрее: Metal).
# По умолчанию http://ollama:11434 — контейнер из профиля local-llm.
DOCKER_OLLAMA_URL=
# Модель Ollama. По умолчанию gemma3:12b.
LOCAL_LLM_MODEL=

# ===== Для разработчиков (можно не трогать) =====
# Тонкая настройка вместо LLM_PROVIDER: hybrid | groq | ollama | offline | fixture
PARSER_MODE=
# Какая модель дополняет правила в hybrid: ollama | groq
HYBRID_LLM=
# Разбор ответов отельера: rules | fixture | ollama | groq. По умолчанию rules.
REPLY_PARSER_MODE=
# Прежнее имя ключа облачной модели; LLM_API_KEY имеет приоритет.
GROQ_API_KEY=
# Только для запуска без Docker и служебных скриптов (docs/DEVELOPMENT.md):
# DATABASE_URL=sqlite:///runtime/adler.db
# OLLAMA_URL=http://127.0.0.1:11434
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OPENAQ_API_KEY=
# NOISEMODELLING_HOME=
# NOISE_JAVA_HOME=
