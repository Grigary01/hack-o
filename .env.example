# offline — без ключей: демо-примеры + правила по словарю реестра; fixture — только демо-примеры
PARSER_MODE=offline
MODEL_NAME=gemma3:12b
OLLAMA_URL=http://127.0.0.1:11434
DATABASE_URL=sqlite:///runtime/adler.db
API_URL=http://127.0.0.1:8000
DEMO_MODE=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Получить ключ: https://explore.openaq.org/register (никогда не коммитить .env)
OPENAQ_API_KEY=
# NoiseModelling without_gui 5.0.1, только для отдельной CLI-команды
NOISEMODELLING_HOME=
NOISE_JAVA_HOME=
# Самый простой облачный вариант: Free Plan https://console.groq.com/keys
# PARSER_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PARSER_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=8192
